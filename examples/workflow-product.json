{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "urun.png" }
  },
  "2": {
    "class_type": "Image Remove Background (rembg)",
    "inputs": { "image": ["1", 0] }
  },
  "3": {
    "class_type": "SplitImageWithAlpha",
    "inputs": { "image": ["2", 0] }
  },
  "4": {
    "class_type": "ImageToMask",
    "inputs": { "image": ["2", 0], "channel": "alpha" }
  },
  "5": {
    "class_type": "GetImageSize+",
    "inputs": { "image": ["1", 0] }
  },
  "6": {
    "class_type": "EmptyImage",
    "inputs": { "width": ["5", 0], "height": ["5", 1], "batch_size": 1, "color": 16777215 }
  },
  "7": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": ["6", 0],
      "source": ["3", 0],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": ["4", 0]
    }
  },
  "8": {
    "class_type": "UpscaleModelLoader",
    "inputs": { "model_name": "4x-UltraSharp.pth" }
  },
  "9": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": { "upscale_model": ["8", 0], "image": ["7", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": { "images": ["9", 0], "filename_prefix": "urun_studio" }
  }
}
