# ComfyUI sunucu adresi (ornek: yerel kurulum)
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
# https/wss kullaniyorsan true yap (reverse proxy arkasinda)
COMFYUI_SECURE=false

# Pipeline varsayilanlari
OUTPUT_DIR=./output
INPUT_DIR=./input

# Upscale modeli (ComfyUI/models/upscale_models altinda olmali)
UPSCALE_MODEL=4x-UltraSharp.pth

# Studyo arka plan rengi (hex, # olmadan)
STUDIO_BG_COLOR=FFFFFF

# Tek bir is icin maksimum bekleme suresi (ms)
JOB_TIMEOUT_MS=180000

# HTTP servis portu (npm run serve)
SERVER_PORT=3000
